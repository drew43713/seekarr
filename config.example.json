{
  "sonarr": {
    "base_url": "http://sonarr:8989/api/v3",
    "base_url_env": "SEEKARR_SONARR_BASE_URL",
    "api_key": "REPLACE_SONARR_API_KEY",
    "api_key_env": "SEEKARR_SONARR_API_KEY",
    "enabled": true
  },
  "radarr": {
    "base_url": "http://radarr:7878/api/v3",
    "base_url_env": "SEEKARR_RADARR_BASE_URL",
    "api_key": "REPLACE_RADARR_API_KEY",
    "api_key_env": "SEEKARR_RADARR_API_KEY",
    "enabled": true
  },
  "limits": {
    "max_series_searches_per_run": 25,
    "max_movie_searches_per_run": 25,
    "max_upgrade_episode_searches_per_run": 200,
    "max_upgrade_movie_searches_per_run": 50,
    "skip_if_queue_over": 200
  },
  "upgrades": {
    "enabled": true
  },
  "state": {
    "path": "/config/seekarr_state.json"
  },
  "runtime": {
    "run_as_cron": true,
    "cron_schedule": "0 */12 * * *",
    "dry_run": false
  }
}
